<mxfile host="app.diagrams.net" type="device"><diagram id="METH" name="Proposed methodology"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="METH1" value="Proposed methodology for the Safia Branch Management System" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=16;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="26" as="geometry"/></mxCell><mxCell id="METH2" value="from Waterfall" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="280" height="20" as="geometry"/></mxCell><mxCell id="METH3" value="1. Baseline" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="280" height="34" as="geometry"/></mxCell><mxCell id="METH4" value="Freeze architecture, integration&lt;br&gt;interfaces and NFR tests.&lt;br&gt;Send the four open questions to head&lt;br&gt;office; model answers as parameters.&lt;br&gt;&lt;br&gt;Output: signed baseline" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="150" as="geometry"/></mxCell><mxCell id="METH5" value="from Scrum" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="410" y="62" width="280" height="20" as="geometry"/></mxCell><mxCell id="METH6" value="2. Module sprints" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="86" width="280" height="34" as="geometry"/></mxCell><mxCell id="METH7" value="Two-week sprints, one package each:&lt;br&gt;orders, pos + inventory, delivery,&lt;br&gt;reporting.&lt;br&gt;Product Owner: pilot branch manager.&lt;br&gt;Review: click-through at the till in a&lt;br&gt;quiet hour.&lt;br&gt;&lt;br&gt;Output: working module" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="410" y="120" width="280" height="150" as="geometry"/></mxCell><mxCell id="METH8" value="from Waterfall" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="62" width="280" height="20" as="geometry"/></mxCell><mxCell id="METH9" value="3. Pilot gate" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="86" width="280" height="34" as="geometry"/></mxCell><mxCell id="METH10" value="One branch (Vega). Formal acceptance&lt;br&gt;against NFR-01 peak load, NFR-02 offline&lt;br&gt;for 24 h, NFR-04 novice users.&lt;br&gt;&lt;br&gt;Output: go / no-go by head office" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="280" height="150" as="geometry"/></mxCell><mxCell id="METH11" value="from Kanban" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1150" y="62" width="280" height="20" as="geometry"/></mxCell><mxCell id="METH12" value="4. Wave rollout" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="86" width="280" height="34" as="geometry"/></mxCell><mxCell id="METH13" value="Branches join in waves, configured per&lt;br&gt;branch (hours, QR, write-off limit).&lt;br&gt;Defects and change requests on a board&lt;br&gt;with a work-in-progress limit.&lt;br&gt;&lt;br&gt;Output: branches live" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1150" y="120" width="280" height="150" as="geometry"/></mxCell><mxCell id="METH14" value="signed" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="METH4" target="METH7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="METH15" value="built" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="METH7" target="METH10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="METH16" value="go" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="METH10" target="METH13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="METH17" value="sprint review updates backlog" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="METH7" target="METH7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="300"/><mxPoint x="480" y="300"/></Array></mxGeometry></mxCell><mxCell id="METH18" value="no-go: back to sprints" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="METH10" target="METH7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="335"/><mxPoint x="550" y="335"/></Array></mxGeometry></mxCell><mxCell id="METH19" value="change requests from live branches" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="METH13" target="METH7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="370"/><mxPoint x="438" y="370"/></Array></mxGeometry></mxCell><mxCell id="METH20" value="Coursework 1 and 2 artefacts feed every stage:  use cases and priorities → sprint backlog   ·   measurable NFRs → pilot gate   ·   class diagrams and packages → one&lt;br&gt;package per sprint   ·   prototypes → sprint reviews" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="1390" height="60" as="geometry"/></mxCell><mxCell id="METH21" value="Solid arrow: normal progress.  Dashed arrow: feedback." style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="1380" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>